public class Main {
    public static void main(String[] args) {
        String str = "aabbccdde";
        String result = "";
        for (int i = 0; i < str.length(); i++) {
            char ch = str.charAt(i);
            if (!result.contains(String.valueOf(ch))) {
                result = result + ch;
            }
        }
        System.out.println(result);
    }
}
