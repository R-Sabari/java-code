import java.util.*;
class Main{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        int small=-1000;
        int big=-1000;
        for(int i=0;i<n;i++){
        if(arr[i] > big)
        {
            small = big;
            big=arr[i];
        }
          else if (arr[i] >small && arr[i] != big) 
          {
                small = arr[i];
           }
        }
        System.out.print(small);
    }
}
